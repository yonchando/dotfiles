# Function
snippet fun "function"
	function ${1:function_name}(${2}) {
		${0:${VISUAL}}
	}
snippet asf "async function"
	async function ${1:function_name}(${2}) {
		${0:${VISUAL}}
	}
# Flow control
snippet if "if (condition) { ... }"
	if (${1:true}) {
		${0:${VISUAL}}
	}
snippet ife "if (condition) { ... } else { ... }"
	if (${1:true}) {
		${0:${VISUAL}}
	} else {
		${2}
	}
snippet if? Ternary: `condition ? true : false`
	$1 ? $2: $0
snippet switch
	switch (${1:expression}) {
		case '${3:case}':
			${4}
			break;
		${0}
		default:
			${2}
	}
snippet case "case 'xyz': ... break"
	case '${1:case}':
		${0:${VISUAL}}
		break;
snippet try "try { ... } catch(e) { ... }"
	try {
		${0:${VISUAL}}
	} catch (${1:e}) {
		${2:/* handle error */}
	}
snippet tryf "try { ... } catch(e) { ... } finally { ... }"
	try {
		${0:${VISUAL}}
	} catch (${1:e}) {
		${2:/* handle error */}
	} finally {
		${3:/* be executed regardless of the try / catch result*/}
	}
snippet terr "throw new Error"
	throw new Error('${1:error message}')
snippet ret "return "
	return ${0:result};
# For loop
snippet fori "Create iteration loop"
	for (let ${1:i} = 0, ${2:len} = ${3:Things.length}; $1 < $2; $1++) {
		${0:${VISUAL}}
	}
snippet forin "Iteration (for..in)"
	for (let ${1:prop} in ${2:object}) {
		${0:$2[$1]}
	}
snippet forof  "Iteration (for..of)"
	for (let ${1:prop} in ${2:object}) {
		${0:$2[$1]}
	}

# JSON.parse
snippet jsonp
	JSON.parse(${0:jstr});
# JSON.stringify
snippet jsons
	JSON.stringify(${0:object});

snippet loge "console.error"
	console.error(${0});
snippet impd "import xyz from 'xyz'"
	import ${1} from '${2:$1}';
snippet impi "import { member } from 'xyz'"
	import { ${1} } from '${2}';

snippet =>
	(${1}) => ${0:${VISUAL}}

snippet ed
	export default ${0}
snippet as "async"
	async ${0}
snippet aw "await"
	await ${0:${VISUAL}}

snippet af "Inserts after() block"
    after(() => {
        ${0}
    })

snippet afe "Inserts afterEach() block"
    afterEach(() => {
        ${0}
    })

snippet bf "Inserts before() block"
    before(() => {
        ${0}
    })
snippet bfe "Inserts beforeEach() block"
    beforeEach(() => {
        ${0}
    })

snippet descr "Inserts describe() block"
    describe('${1}', () => {
        ${0}
    })

snippet it "Inserts it() block"
    it('should ${1}', () => {
        ${0}
    })
