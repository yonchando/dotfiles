extends javascript

snippet const "ts const"
	const ${1}: ${2:any} = ${3};
	${0}
snippet let "ts let"
	let ${1}: ${2:any} = ${3};
	${0}
snippet var "ts var"
	var ${1}: ${2:any} = ${3};
	${0}

snippet pub "ts create public field"
	public ${1}: ${0:any}
snippet pri "ts create private field"
	private ${1}: ${0:any}
snippet pro "ts create protected field"
	protected ${1}: ${0:any}

snippet int "interface"
	interface ${1} {
		${2}: ${3:any};
		${0}
	}
snippet intx "interface extends"
	interface ${1} extends ${2} {
		${3}: ${4:any};
		${0}
	}
snippet fun "ts function"
	function ${1}(${2}): ${3:any} {
		${0}
	}
snippet pubf "ts public method"
	public ${1}(${2}): ${3:any} {
		${0}
	}
snippet pubsf "ts public static method"
	public static ${1}(${2}): ${3:any} {
		${0}
	}
snippet prif "ts private method"
	private ${1}(${2}): ${3:any} {
		${0}
	}
snippet prof "ts protected method"
	protected ${1}(${2}): ${3:any} {
		${0}
	}
snippet cls "ts export class"
	export class ${1} {
		${0}
	}
snippet clsx "ts class extends"
	export class ${1} extends ${2} {
		${3}
		constructor(public ${4}: ${5: any}) {
			${6}
		}
		${0}
	}

# anguglar
snippet cmp "computed(() => {})"
    computed(() => {
        $0
    })

snippet cp "computed(() => {})"
    protected readonly $1 = computed(() => {
        $0
    })

snippet si "signal()"
    $1 = signal($0);

snippet in "signal()"
    $1 = input($0);
