{
    "layer": "top",
    "position": "top",
    "margin-bottom": -10,
    "spacing": 0,
    "modules-left": [
        "hyprland/workspaces",
        "hyprland/window",
        "hyprland/submap"
    ],
    "modules-center": ["clock"],
    "modules-right": ["tray", "hyprland/language", "group/right"],
    "group/right": {
        "orientation": "inherit",
        "modules": [
            "pulseaudio",
            "network",
            "battery",
            "user",
            "custom/notification",
            "custom/power"
        ]
    },
    "user": {
        "format": "{user} ",
        "interval": 60,
        "icon": false
    },
    "hyprland/window": {
        "format": "{class}",
        "separate-outputs": true,
        "on-click": "hyprctl activewindow -j | jq -r .class | wl-copy"
    },
    "hyprland/submap": {
        "format": "✌️ {}",
        "max-length": 8,
        "tooltip": false
    },
    "hyprland/workspaces": {
        "disable-scroll": false,
        "all-outputs": false,
        "format": "{name}: {icon}",
        "format-icons": {
            "1": "󰣇",
            "2": "",
            "3": "",
            "4": "󰲌",
            "6": "",
            "urgent": "",
            "default": ""
        },
        "on-click": "activate"
    },
    "hyprland/language": {
        "format": "{}",
        "format-en": "US",
        "format-kh": "KH",
        "on-click": "hyprctl switchxkblayout at-translated-set-2-keyboard next"
    },
    "clock": {
        "timezone": "Asia/Phnom_Penh",
        "tooltip": false,
        "format": "{:%I:%M %p  -  %A, %d/%m}",
        "interval": 60,
        "on-click": "gnome-calendar"
    },
    "tray": {
        "icon-size": 16,
        "spacing": 10
    },
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "bat": "BAT0",
        "interval": 60,
        "full-at": "95",
        "format": "{capacity}% {icon}",
        "format-icons": {
            "discharging": "󱧥",
            "plugged": ["󱞝"],
            "full": ["󰁹"],
            "charging": ["󰢟", "󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"],
            "default": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
        }
    },
    "network": {
        "format-wifi": "󰤢 ({essid})",
        "format-ethernet": "󰈀 Connected",
        "format-disconnected": "󰤠 Disconnected",
        "interval": 6,
        "tooltip": false
    },
    "pulseaudio": {
        "format": "{volume}% {icon}",
        "format-muted": "",
        "format-icons": {
            "default": ["", "", ""]
        },
        "on-click": "pavucontrol"
    },
    "custom/power": {
        "tooltip": false,
        "on-click": "~/dotfiles/rofi/powermenu/powermenu.sh",
        "format": "⏻"
    },
    "custom/notification": {
        "tooltip": true,
        "format": "<span size='14pt'>{icon}</span>",
        "format-icons": {
            "notification": "󱅫",
            "none": "󰂜",
            "dnd-notification": "󰂠",
            "dnd-none": "󰪓",
            "inhibited-notification": "󰂛",
            "inhibited-none": "󰪑",
            "dnd-inhibited-notification": "󰂛",
            "dnd-inhibited-none": "󰪑"
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
    }
}
